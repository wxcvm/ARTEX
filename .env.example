# Docker deployment configuration (copy to .env)
# Default is the historical upstream image, not a build of this fork.
# Set ARTEX_IMAGE to the repository/image you built or published for wxcvm/ARTEX.
ARTEX_IMAGE=autumn27/artex
ARTEX_TAG=latest
# Default is localhost-only. Set an explicit host IP only when you intend remote access.
# ARTEX_BIND=127.0.0.1
# Optional operator-chosen first-setup token; empty generates a one-time token in startup logs.
# ARTEX_SETUP_TOKEN=
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (fill one or both; you can also leave empty and configure in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Optional: frame tool output as untrusted data for the agent (default off).
# ARTEX_UNTRUSTED_BOUNDARY=1
