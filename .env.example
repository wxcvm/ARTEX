# Docker deployment configuration (copy to .env)
# Default is the historical upstream image, not a build of this fork.
# Set ARTEX_IMAGE to the repository/image you built or published for wxcvm/ARTEX.
ARTEX_IMAGE=autumn27/artex
ARTEX_TAG=latest
# Default is localhost-only. Set an explicit host IP only when you intend remote access.
# ARTEX_BIND=127.0.0.1
# Optional operator-chosen first-setup token; empty generates a one-time token in startup logs.
# ARTEX_SETUP_TOKEN=
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (fill one or both; you can also leave empty and configure in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Tool output is framed as untrusted data by default (no tool permissions change).
# Set to 0 only to restore the legacy, unframed model input format.
# ARTEX_UNTRUSTED_BOUNDARY=0

# Docker container resource ceilings (tune for host RAM and concurrent workloads).
# Default ARTEX container: 4 GiB / 512 processes; PostgreSQL is not capped here.
ARTEX_MEMORY_LIMIT=4g
ARTEX_PIDS_LIMIT=512
# Isolated runner / Mode B: smaller controller plus a separate tool executor.
ARTEX_CONTROLLER_MEMORY_LIMIT=1g
ARTEX_CONTROLLER_PIDS_LIMIT=256
ARTEX_EXECUTOR_MEMORY_LIMIT=4g
ARTEX_EXECUTOR_PIDS_LIMIT=512
