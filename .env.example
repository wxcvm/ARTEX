# Docker deployment configuration (copy to .env)
# Default is the historical upstream image, not a build of this fork.
# Set ARTEX_IMAGE to the repository/image you built or published for wxcvm/ARTEX.
ARTEX_IMAGE=autumn27/artex
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (fill one or both; you can also leave empty and configure in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
